# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# The one email address allowed into /admin. Create this user in Supabase > Authentication > Users.
ADMIN_EMAIL=you@example.com

# ---- Contact form delivery (optional). Without these, messages are logged to the server console. ----
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public URL used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Feedback moderation ----
# Default (recommended for job hunting): new feedback waits for your approval in /admin.
# Set to "off" to publish feedback immediately.
# COMMENTS_MODERATION=off
